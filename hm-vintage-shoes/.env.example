# Copy this file to .env (never commit .env). Every setting is optional:
# without Daraja credentials the store runs in M-Pesa SIMULATION mode, so the
# whole checkout flow can be tried without moving any money.

HOST=127.0.0.1
PORT=3000
# Extra Host headers to accept, e.g. when testing from a phone with HOST=0.0.0.0
# ALLOWED_HOSTS=192.168.1.20:3000

# --- Safaricom Daraja: M-Pesa Express (STK Push) ---
# sandbox or production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill or store number (174379 is Safaricom's sandbox test shortcode)
MPESA_SHORTCODE=174379
# From the Daraja portal (sandbox: Test Credentials on the M-Pesa Express page)
MPESA_PASSKEY=
# CustomerPayBillOnline for a Paybill, CustomerBuyGoodsOnline for a Till number
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till number (only for CustomerBuyGoodsOnline); defaults to MPESA_SHORTCODE
# MPESA_PARTY_B=
# Public HTTPS address Safaricom can reach, e.g. an ngrok or Cloudflare tunnel to this server.
# Payment status is also verified through the STK Query API, so checkout still
# completes on localhost if callbacks cannot reach you.
MPESA_CALLBACK_BASE_URL=https://your-tunnel.example.com
